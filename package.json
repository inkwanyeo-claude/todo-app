{
  "name": "todo2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
